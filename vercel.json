{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.js?__vpath=/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/index.js?__vpath=/admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.js?__vpath=/admin/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js?__vpath=/$1"
    }
  ]
}
