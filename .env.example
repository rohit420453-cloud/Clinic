# MongoDB Atlas Connection String (Required in production)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# MongoDB Database Name
MONGODB_DB_NAME="smilecraft_dental"

# Initial Administrator Credentials (Change password immediately in production)
ADMIN_EMAIL="admin@smilecraft.example"
ADMIN_PASSWORD="ChangeMe@12345"

# Cryptographic Session / Token Signing Secret (Use a 64+ char random hex string in production)
SESSION_SECRET="replace_with_a_strong_64_character_random_secret_in_production"

# Clinic Configuration
CLINIC_TIMEZONE="Asia/Kolkata"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Demonstration Mode ("true" seeds illustrative sample records on empty database; set to "false" in production)
DEMO_MODE="true"

# Optional Approved CORS Origin
CORS_ORIGIN=""
